### المرحلة 2: قاعدة البيانات (Prisma Schema)

#### [MODIFY] `schema.prisma` — إضافة 3 models جديدة:

```prisma
model InstagramConversation {
  id               String    @id @default(uuid())
  connectionId     String                         // ربط بـ InstagramConnection
  participantIgId  String                         // igUserId للمتحدث
  participantName  String?
  participantPic   String?
  lastMessageAt    DateTime  @default(now())
  lastMessageText  String?
  unreadCount      Int       @default(0)
  status           String    @default("open")     // open | archived | spam
  tags             String[]  @default([])         // ["طلب شراء", "شكوى"]
  assignedTo       String?                        // userId of team member
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  connection       InstagramConnection @relation(...)
  messages         InstagramMessage[]
  
  @@unique([connectionId, participantIgId])
  @@index([connectionId, lastMessageAt])
  @@index([status])
  @@map("instagram_conversations")
}

model InstagramMessage {
  id               String    @id @default(uuid())
  conversationId   String
  igMessageId      String?   @unique              // Meta message ID
  direction        String                         // "inbound" | "outbound"
  contentType      String    @default("text")     // text | image | video | audio | story_reply | story_mention
  text             String?
  mediaUrl         String?
  storyUrl         String?
  isRead           Boolean   @default(false)
  sentAt           DateTime  @default(now())
  deliveredAt      DateTime?
  readAt           DateTime?
  metadata         Json?                          // بيانات إضافية
  createdAt        DateTime  @default(now())
  
  conversation     InstagramConversation @relation(...)
  
  @@index([conversationId, sentAt])
  @@map("instagram_messages")
}

model InstagramWebhookLog {
  id          String   @id @default(uuid())
  eventType   String
  payload     Json
  status      String   @default("processed")      // processed | failed | ignored
  error       String?
  processedAt DateTime @default(now())
  
  @@index([eventType])
  @@index([processedAt])
  @@map("instagram_webhook_logs")
}
```

