# ============================================
# ☁️ AWS S3 CONFIGURATION
# ============================================
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
S3_BUCKET="your-bucket-name"
# Optional: SSE-KMS for identity documents and sensitive uploads (falls back to SSE-S3 AES256)
AWS_KMS_KEY_ID=""
S3_UPLOAD_MAX_MB=5
S3_UPLOAD_MAX_FILES=3
S3_PRODUCT_IMAGE_MAX_SIZE=5242880
S3_PRODUCT_IMAGE_MAX_COUNT=5

