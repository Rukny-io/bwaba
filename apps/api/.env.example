# ============================================
# 🗄️ DATABASE CONFIGURATION
# ============================================
# Neon PostgreSQL - Use your Neon connection string
# connection_limit: Max connections in pool (default: num_cpus * 2 + 1)
# pool_timeout: Seconds to wait for connection (default: 10)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require&connection_limit=10&pool_timeout=20"

# ============================================
# 🔐 SECURITY & AUTHENTICATION
# ============================================
# JWT Configuration (generate with: openssl rand -hex 32)
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters"
JWT_EXPIRATION="7d"

# Two-Factor Authentication (generate with: openssl rand -hex 32)
TWO_FACTOR_ENCRYPTION_KEY="your-2fa-encryption-key-minimum-32-characters"

# Form email OTP HMAC pepper (generate with: openssl rand -hex 32)
FORMS_OTP_PEPPER="your-forms-otp-pepper-minimum-32-characters"

# Internal API Secret (for proxy communication)
INTERNAL_API_SECRET="your-internal-api-secret-key"

# ============================================
# 🛡️ CLOUDFLARE TURNSTILE (Forms bot protection)
# ============================================
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# Widget mode: Managed (recommended) or Non-interactive
TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# ============================================
# 🌍 FORMS GEO ANALYTICS (optional)
# ============================================
# GEOIP_PROVIDER controls how visitor country/city is resolved:
#   cloudflare — ONLY uses Cloudflare CF-IP* headers (requires: DNS Proxied + IP Geolocation ON)
#   ipapi      — ONLY uses ip-api.com (free: 45req/min, HTTP only)
#   auto       — Cloudflare first, ip-api fallback if CF headers missing (RECOMMENDED)
#
# Production setup (Cloudflare Proxy):
#   1. DNS → Proxied (orange cloud) for api.rukny.io + all subdomains
#   2. Cloudflare Dashboard → Network → IP Geolocation → ON
#   3. (Optional) Rules → Transform Rules → Managed Transforms → "Add visitor location headers"
#   4. nginx/includes/proxy-cloudflare.conf forwards CF-IPCity / CF-IPRegion
#   5. Do NOT set GEOIP_MOCK_* in production
#
# ⚠️  Use 'auto' (not 'cloudflare') to avoid silent data loss when CF headers are missing.
GEOIP_PROVIDER=auto
# Mock country code for local/private IPs (e.g. IQ for Iraq demo data)
GEOIP_MOCK_COUNTRY="IQ"
# Optional: ISO 3166-2:IQ code for local mock (e.g. IQ-BA for Basra)
# GEOIP_MOCK_GOVERNORATE="IQ-BA"
# GEOIP_MOCK_CITY="Basra"
#
# Optional: ip-api.com Pro API key (removes rate limits, enables HTTPS)
# IPAPI_API_KEY=""

# ============================================
# 🔴 REDIS CONFIGURATION
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# ============================================
# 🌐 APPLICATION CONFIGURATION
# ============================================
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"
# Forms dashboard (apps/forms) — OAuth redirects e.g. Google Sheets
FORMS_APP_URL="http://localhost:3007"
# Public form respondent site (apps/public) — e.g. http://localhost:3006/f/{slug}
FORM_PUBLIC_BASE_URL="http://localhost:3006"

# Cookie Configuration
COOKIE_DOMAIN=""
COOKIE_SECURE=false

# ============================================
# 🔑 OAUTH - GOOGLE
# ============================================
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# ============================================
# 🔑 OAUTH - GITHUB
# ============================================
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:3001/api/v1/auth/github/callback"
# Set to true to enable login/linking for each provider (default: google + linkedin on, github + facebook off)
OAUTH_GOOGLE_ENABLED=true
OAUTH_LINKEDIN_ENABLED=true
OAUTH_GITHUB_ENABLED=false
OAUTH_FACEBOOK_ENABLED=false

# ============================================
# 🔑 OAUTH - LINKEDIN
# ============================================
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_CALLBACK_URL="http://localhost:3001/api/v1/auth/linkedin/callback"
LINKEDIN_SCOPES="openid,profile,email"

# ============================================
# 🔑 OAUTH - FACEBOOK LOGIN
