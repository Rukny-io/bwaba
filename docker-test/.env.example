# ============================================
# Rukny docker-test — copy to .env and fill in
# ============================================

# ─── Secrets (required) ───
DB_USER=rukny_admin
DB_PASSWORD=change-me-strong-password
DB_NAME=rukny_docker_test
REDIS_PASSWORD=change-me-redis-password
JWT_SECRET=change-me-minimum-32-characters-long-secret

# Optional API secrets (copy from .env.dev if needed)
TWO_FACTOR_ENCRYPTION_KEY=
INTERNAL_API_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.rukny.io/api/v1/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=https://api.rukny.io/api/v1/auth/linkedin/callback
LINKEDIN_INTEGRATION_CALLBACK_URL=https://api.rukny.io/api/v1/integrations/linkedin/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://api.rukny.io/api/v1/auth/facebook/callback
INSTAGRAM_REDIRECT_URI=https://api.rukny.io/api/v1/integrations/instagram/callback
YOUTUBE_REDIRECT_URI=https://api.rukny.io/api/v1/integrations/youtube/callback
GOOGLE_SHEETS_REDIRECT_URI=https://api.rukny.io/api/v1/integrations/google-sheets/callback

# ─── apps/app على rukny.work (تضمين النموذج) ───
APP_HOST=rukny.work
NEXT_PUBLIC_APP_URL=https://rukny.work
NEXT_PUBLIC_FORM_PUBLIC_ORIGIN=https://rukny.io
NEXT_PUBLIC_EMBED_FORM_SLUG=57fb02

# ─── باقي الخدمات (نطاقات الاختبار أو الإنتاج) ───
NEXT_PUBLIC_ROOT_DOMAIN=rukny.io
COOKIE_DOMAIN=
COOKIE_SECURE=true

API_HOST=api.rukny.io
ACCOUNTS_HOST=accounts.rukny.io
PUBLIC_HOST=rukny.io
DEVELOPER_HOST=developers.rukny.io
FORMS_HOST=forms.rukny.io

API_PUBLIC_BASE=https://api.rukny.io
NEXT_PUBLIC_API_EXTERNAL_URL=https://api.rukny.io/api/v1
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.rukny.io
NEXT_PUBLIC_PUBLIC_SITE_URL=https://rukny.io
NEXT_PUBLIC_DEVELOPERS_URL=https://developers.rukny.io
NEXT_PUBLIC_FORMS_URL=https://forms.rukny.io
NEXT_PUBLIC_BUSINESS_URL=https://business.rukny.io

# ─── Cloudflare Tunnel (Zero Trust → Tunnels → your tunnel → token) ───
CLOUDFLARE_TUNNEL_TOKEN=

# Geo / forms
GEOIP_PROVIDER=auto
