{
  "name": "@rukny/auth",
  "version": "1.0.0",
  "description": "Shared authentication package for Rukny applications",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.mjs",
      "require": "./dist/middleware/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.mjs",
      "require": "./dist/config/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js"
    },
    "./server": "./src/server/index.ts",
    "./client/session-keepalive": "./src/client/session-keepalive.tsx"
  },
  "scripts": {
    "build": "tsup src/index.ts src/middleware/index.ts src/types/index.ts src/config/index.ts src/utils/index.ts --format cjs,esm --dts --out-dir dist --clean",
    "dev": "tsup src/index.ts src/middleware/index.ts src/types/index.ts src/config/index.ts src/utils/index.ts --format cjs,esm --dts --out-dir dist --clean --watch",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "tsup": "^8.0.0",
    "typescript": "^5"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "zod": "^3.22.0"
  }
}
