{
  "name": "@rukny/whatsapp",
  "version": "0.1.0",
  "description": "Official Rukny WhatsApp API client for Node.js (server-side only)",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi",
    "RuknyWhatsApp.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --out-dir dist --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --out-dir dist --clean --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://developers.rukny.io",
  "keywords": [
    "rukny",
    "whatsapp",
    "whatsapp-api",
    "messaging",
    "otp"
  ]
}
